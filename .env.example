# ── FinTrack — environment variables ──────────────────────────────
# Copy this file to `.env.local` and fill in real values.

# PostgreSQL connection string.
# Supabase → Project Settings → Database → Connection string.
# For serverless (Vercel) prefer the Transaction pooler (port 6543):
#   postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# NextAuth v5 signing secret (required in production).
# Generate one with:  npx auth secret
AUTH_SECRET=

# Groq API key for the AI daily tip — https://console.groq.com
GROQ_API_KEY=
